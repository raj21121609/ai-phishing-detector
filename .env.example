# Environment Variables
# Do not put actual secrets in this file. Copy to .env and configure.

# Django Settings
DJANGO_SECRET_KEY=your_development_secret_key
DJANGO_DEBUG=True

# Database Settings (PostgreSQL)
DB_NAME=phishguard
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# ML Settings
MODEL_PATH=../ml/models/latest_model.joblib
